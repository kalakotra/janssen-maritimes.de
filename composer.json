{
    "name": "silverstripe/installer",
    "type": "silverstripe-recipe",
    "description": "The SilverStripe For Blue Sailing",
    "require": {
        "php": "^8.3",
        "silverstripe/recipe-cms": "~6.3.0",
        "silverstripe/login-forms": "^6.0",
        "axllent/silverstripe-scss": "^2.1",
        "axllent/silverstripe-minifier": "^2.0",
        "axllent/silverstripe-trailing-slash": "^2.2",
        "wilr/silverstripe-googlesitemaps": "^4.0",
        "symbiote/silverstripe-gridfieldextensions": "^5.0",
        "bummzack/sortablefile": "^3.0",
        "axllent/silverstripe-meta-editor": "^1.2",
        "tractorcow/silverstripe-fluent": "^8.0",
        "undefinedoffset/silverstripe-nocaptcha": "^3.0",
        "silverstripe/userforms": "^7.0",
        "jonom/focuspoint": "^6.0",
        "silverstripe/lumberjack": "^4.0",
        "silverstripe/htmleditor-tinymce": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3"
    },
    "extra": {
        "resources-dir": "_resources",
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml"
        ]
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Amir Mehmedovic",
            "email": "kalakotra@gmail.com",
            "homepage": "https://brandfisher.de",
            "role": "Developer"
        }
    ],
    "homepage": "https://blue-yachting.de"
}
